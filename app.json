{
  "expo": {
    "name": "Kite",
    "slug": "kite",
    "scheme": "kite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logokite.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logokite.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.workspace.kite",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "LSApplicationQueriesSchemes": [
          "shareddocuments"
        ],
        "NSFaceIDUsageDescription": "Kite sử dụng Face ID hoặc Touch ID để bảo vệ và mở khóa mật khẩu đã lưu của bạn.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logokite.png",
        "backgroundColor": "#0c0d13"
      },
      "package": "com.workspace.kite"
    },
    "web": {
      "favicon": "./assets/logokite.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Cho phép Kite truy cập microphone để tìm kiếm bằng giọng nói.",
          "speechRecognitionPermission": "Cho phép Kite nhận diện giọng nói tiếng Việt."
        }
      ],
      "expo-secure-store",
      "expo-splash-screen"
    ]
  }
}
